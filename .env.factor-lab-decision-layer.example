# Factor Lab decision-layer provider settings
# Copy the needed lines into `.env` for the research daemon / scripts.

# -----------------------------
# Option A: External OpenAI-compatible provider (recommended)
# -----------------------------

# Use any OpenAI-compatible endpoint for decision layer LLM calls.
# This is the preferred primary path for new deployments.

# OpenAI-compatible endpoint root, no trailing slash
FACTOR_LAB_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1

# Provider API key
FACTOR_LAB_LLM_API_KEY=***

# Model used by planner / failure analyst decision layer
FACTOR_LAB_LLM_MODEL=gpt-4o-mini

# Optional: force provider mode (auto-detected if not set)
# FACTOR_LAB_DECISION_PROVIDER=real_llm

# Optional timeout
FACTOR_LAB_LLM_TIMEOUT_SECONDS=20

# -----------------------------
# Option B: OpenClaw internal sessions (legacy/advanced)
# -----------------------------

# Use OpenClaw Gateway /v1/chat/completions with request-scoped session keys.
# This is an optional compatibility backend for existing OpenClaw deployments.

# FACTOR_LAB_DECISION_PROVIDER=openclaw_gateway
# FACTOR_LAB_OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1/chat/completions
# FACTOR_LAB_OPENCLAW_PLANNER_AGENT=factor-lab-planner
# FACTOR_LAB_OPENCLAW_FAILURE_AGENT=factor-lab-failure
# FACTOR_LAB_OPENCLAW_SESSION_PREFIX=factor-lab-decision
# FACTOR_LAB_OPENCLAW_SESSION_MODE=persistent

# Optional: only set this if the target agents explicitly allow model override.
# FACTOR_LAB_OPENCLAW_BACKEND_MODEL=codex-for-me/gpt-5.4
