{
  "schema_version": 1,
  "data_source": "tushare_market_daily",
  "start_date": "2017-01-01",
  "end_date": "latest",
  "fetch_start_date": "2016-06-01",
  "raw_cache_dir": "artifacts/expanded_long_only/raw_market",
  "feature_store_dir": "artifacts/expanded_long_only/feature_store",
  "checkpoint_path": "artifacts/expanded_long_only/download_checkpoint.json",
  "request_rate_per_minute": 300,
  "download_workers": 1,
  "checkpoint_flush_every": 25,
  "market_detail_source": "hybrid_tushare_basic_akshare_hfq",
  "akshare_workers": 4,
  "retry_missing_akshare": false,
  "akshare_minimum_initial_coverage": 0.9,
  "tushare_supplement_workers": 8,
  "universe": {
    "mode": "monthly_liquid_top_n",
    "target_size": 500,
    "liquidity_lookback_days": 60,
    "min_liquidity_observations": 40,
    "min_listing_days": 180,
    "exclude_historical_st": true,
    "st_filter_degraded_allowed": true
  },
  "portfolio": {
    "mode": "long_only",
    "capital": 50000000,
    "holding_days": 5,
    "rebalance_every_days": 5,
    "position_count": 50,
    "max_adv_participation": 0.05,
    "open_column": "open_adj",
    "adv_column": "adv_20",
    "volatility_column": "volatility_20",
    "benchmark": "eligible_universe_equal_weight"
  },
  "costs": {
    "commission_rate": 0.0003,
    "slippage_bps_per_side": 5.0,
    "stamp_duty_before_2023_08_28": 0.001,
    "stamp_duty_from_2023_08_28": 0.0005,
    "exchange_handling_rate": 0.0000341,
    "transfer_fee_rate": 0.00001,
    "impact_coefficient": 0.5
  },
  "splits": {
    "train": ["2017-01-01", "2022-12-31"],
    "validation": ["2023-01-01", "2024-12-31"],
    "observed_audit": ["2025-01-01", "latest"]
  },
  "multiple_testing": {
    "method": "benjamini_hochberg",
    "max_variants": 6,
    "max_q_value": 0.1
  },
  "promotion_gate": {
    "validation_net_excess_annual_return_min": 0.0,
    "validation_net_sharpe_min": 0.8,
    "validation_max_drawdown_min": -0.25,
    "positive_half_year_ratio_min": 0.6,
    "average_holding_count_min": 40,
    "capacity_violation_count_max": 0
  },
  "output_dir": "artifacts/expanded_long_only"
}
