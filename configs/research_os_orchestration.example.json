{
  "schema_version": "research-os/application-services/v1",
  "repository": "..",
  "path_base": ".",
  "dependency_lock": "uv.lock",
  "sleeve_roster_path": "configs/research_os_initial_sleeves.json",
  "iceberg": {
    "catalog_name": "factorlab"
  },
  "daily": {
    "sources": [
      {
        "source": "tushare",
        "profile_name": "primary-tushare",
        "token_env": "TUSHARE_TOKEN",
        "priority": 10,
        "endpoint_map": {
          "daily": "daily"
        },
        "rate_limits": {
          "daily": {
            "requests": 100,
            "per_seconds": 60,
            "burst": 2
          }
        },
        "request": {
          "dataset": "daily",
          "parameters": {
            "trade_date": "${partition_yyyymmdd}"
          },
          "fields": [
            "ts_code",
            "trade_date",
            "open",
            "high",
            "low",
            "close",
            "pre_close",
            "vol",
            "amount"
          ]
        },
        "contract": {
          "dataset": "daily",
          "key_fields": [
            "ts_code",
            "trade_date"
          ],
          "event_time_field": "trade_date",
          "release_timing": "exchange close plus 30 minutes Asia/Shanghai",
          "allows_empty": false,
          "fields": [
            {"name": "ts_code", "dtype": "string", "nullable": false},
            {"name": "trade_date", "dtype": "date", "nullable": false},
            {"name": "open", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "high", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "low", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "close", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "pre_close", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "vol", "dtype": "float64", "nullable": false, "unit": "100 shares"},
            {"name": "amount", "dtype": "float64", "nullable": false, "unit": "thousand CNY"}
          ]
        },
        "canonicalization": {
          "entity_columns": ["ts_code"],
          "event_time_column": "trade_date",
          "value_columns": ["open", "high", "low", "close", "pre_close", "vol", "amount"],
          "availability": {
            "mode": "session_release_time",
            "time": "15:30:00",
            "timezone": "Asia/Shanghai",
            "lag_days": 0
          }
        }
      },
      {
        "source": "akshare",
        "profile_name": "secondary-akshare",
        "priority": 20,
        "endpoint_map": {"daily": "stock_zh_a_hist"},
        "probe_endpoint": "stock_zh_a_hist",
        "probe_parameters": {
          "symbol": "000001",
          "period": "daily",
          "start_date": "20240102",
          "end_date": "20240103",
          "adjust": ""
        },
        "response_field_mapping": {
          "日期": "trade_date",
          "开盘": "open",
          "最高": "high",
          "最低": "low",
          "收盘": "close"
        },
        "constant_fields": {"ts_code": "000001.SZ"},
        "request": {
          "dataset": "daily",
          "parameters": {
            "symbol": "000001",
            "period": "daily",
            "start_date": "${partition_yyyymmdd}",
            "end_date": "${partition_yyyymmdd}",
            "adjust": ""
          },
          "fields": ["ts_code", "trade_date", "open", "high", "low", "close"]
        },
        "contract": {
          "dataset": "daily",
          "key_fields": ["ts_code", "trade_date"],
          "event_time_field": "trade_date",
          "release_timing": "exchange close plus 30 minutes Asia/Shanghai",
          "allows_empty": false,
          "fields": [
            {"name": "ts_code", "dtype": "string", "nullable": false},
            {"name": "trade_date", "dtype": "date", "nullable": false},
            {"name": "open", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "high", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "low", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "close", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"}
          ]
        },
        "canonicalization": {
          "entity_columns": ["ts_code"],
          "event_time_column": "trade_date",
          "value_columns": ["open", "high", "low", "close"],
          "availability": {
            "mode": "session_release_time",
            "time": "15:30:00",
            "timezone": "Asia/Shanghai",
            "lag_days": 0
          }
        }
      },
      {
        "source": "local_file",
        "profile_name": "daily-crosscheck-local",
        "root": "data/source_crosscheck",
        "priority": 20,
        "path_templates": {
          "daily": "daily/{trade_date}.parquet"
        },
        "request": {
          "dataset": "daily",
          "parameters": {
            "trade_date": "${partition_key}"
          }
        },
        "contract": {
          "dataset": "daily",
          "key_fields": ["ts_code", "trade_date"],
          "event_time_field": "trade_date",
          "release_timing": "normalized cross-check available by 15:30 Asia/Shanghai",
          "allows_empty": false,
          "fields": [
            {"name": "ts_code", "dtype": "string", "nullable": false},
            {"name": "trade_date", "dtype": "date", "nullable": false},
            {"name": "open", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "high", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "low", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "close", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "pre_close", "dtype": "float64", "nullable": false, "unit": "CNY", "adjustment": "raw"},
            {"name": "vol", "dtype": "float64", "nullable": false, "unit": "100 shares"},
            {"name": "amount", "dtype": "float64", "nullable": false, "unit": "thousand CNY"}
          ]
        },
        "canonicalization": {
          "entity_columns": ["ts_code"],
          "event_time_column": "trade_date",
          "value_columns": ["open", "high", "low", "close", "pre_close", "vol", "amount"],
          "availability": {
            "mode": "session_release_time",
            "time": "15:30:00",
            "timezone": "Asia/Shanghai",
            "lag_days": 0
          }
        }
      },
      {
        "source": "tushare",
        "profile_name": "primary-tushare",
        "token_env": "TUSHARE_TOKEN",
        "priority": 10,
        "endpoint_map": {"daily_basic": "daily_basic"},
        "request": {
          "dataset": "daily_basic",
          "parameters": {"trade_date": "${partition_yyyymmdd}"},
          "fields": ["ts_code", "trade_date", "turnover_rate", "volume_ratio", "pe", "pb", "total_mv", "circ_mv"]
        },
        "contract": {
          "dataset": "daily_basic",
          "key_fields": ["ts_code", "trade_date"],
          "event_time_field": "trade_date",
          "release_timing": "provider daily release at 18:30 Asia/Shanghai",
          "allows_empty": false,
          "fields": [
            {"name": "ts_code", "dtype": "string", "nullable": false},
            {"name": "trade_date", "dtype": "date", "nullable": false},
            {"name": "turnover_rate", "dtype": "float64", "nullable": true, "unit": "percent"},
            {"name": "volume_ratio", "dtype": "float64", "nullable": true},
            {"name": "pe", "dtype": "float64", "nullable": true},
            {"name": "pb", "dtype": "float64", "nullable": true},
            {"name": "total_mv", "dtype": "float64", "nullable": true, "unit": "ten-thousand CNY"},
            {"name": "circ_mv", "dtype": "float64", "nullable": true, "unit": "ten-thousand CNY"}
          ]
        },
        "canonicalization": {
          "entity_columns": ["ts_code"],
          "event_time_column": "trade_date",
          "value_columns": ["turnover_rate", "volume_ratio", "pe", "pb", "total_mv", "circ_mv"],
          "availability": {
            "mode": "session_release_time",
            "time": "18:30:00",
            "timezone": "Asia/Shanghai",
            "lag_days": 0
          }
        }
      },
      {
        "source": "tushare",
        "profile_name": "primary-tushare",
        "token_env": "TUSHARE_TOKEN",
        "priority": 10,
        "endpoint_map": {"adj_factor": "adj_factor"},
        "request": {
          "dataset": "adj_factor",
          "parameters": {"trade_date": "${partition_yyyymmdd}"},
          "fields": ["ts_code", "trade_date", "adj_factor"]
        },
        "contract": {
          "dataset": "adj_factor",
          "key_fields": ["ts_code", "trade_date"],
          "event_time_field": "trade_date",
          "release_timing": "provider daily release at 18:30 Asia/Shanghai",
          "allows_empty": false,
          "fields": [
            {"name": "ts_code", "dtype": "string", "nullable": false},
            {"name": "trade_date", "dtype": "date", "nullable": false},
            {"name": "adj_factor", "dtype": "float64", "nullable": false, "adjustment": "factor"}
          ]
        },
        "canonicalization": {
          "entity_columns": ["ts_code"],
          "event_time_column": "trade_date",
          "value_columns": ["adj_factor"],
          "availability": {
            "mode": "session_release_time",
            "time": "18:30:00",
            "timezone": "Asia/Shanghai",
            "lag_days": 0
          }
        }
      },
      {
        "source": "local_file",
        "profile_name": "pit-reference-local",
        "root": "data/reference/pit",
        "priority": 10,
        "path_templates": {"trade_status": "trade_status/{trade_date}.parquet"},
        "request": {
          "dataset": "trade_status",
          "parameters": {"trade_date": "${partition_key}"}
        },
        "contract": {
          "dataset": "trade_status",
          "key_fields": ["ts_code", "trade_date"],
          "event_time_field": "trade_date",
          "release_timing": "PIT status captured after exchange close; available_at is required",
          "allows_empty": false,
          "fields": [
            {"name": "ts_code", "dtype": "string", "nullable": false},
            {"name": "trade_date", "dtype": "date", "nullable": false},
            {"name": "available_at", "dtype": "timestamp[UTC]", "nullable": false, "release_timing": "source evidence timestamp"},
            {"name": "trade_status", "dtype": "string", "nullable": false},
            {"name": "is_suspended", "dtype": "bool", "nullable": false},
            {"name": "up_limit", "dtype": "float64", "nullable": true, "unit": "CNY", "adjustment": "raw"},
            {"name": "down_limit", "dtype": "float64", "nullable": true, "unit": "CNY", "adjustment": "raw"}
          ]
        },
        "canonicalization": {
          "entity_columns": ["ts_code"],
          "event_time_column": "trade_date",
          "available_at_column": "available_at",
          "value_columns": ["trade_status", "is_suspended", "up_limit", "down_limit"]
        }
      },
      {
        "source": "tushare",
        "profile_name": "primary-tushare",
        "token_env": "TUSHARE_TOKEN",
        "priority": 10,
        "endpoint_map": {"trade_calendar": "trade_cal"},
        "request": {
          "dataset": "trade_calendar",
          "parameters": {
            "exchange": "SSE",
            "start_date": "${partition_yyyymmdd}",
            "end_date": "${partition_yyyymmdd}"
          },
          "fields": ["exchange", "cal_date", "is_open", "pretrade_date"]
        },
        "contract": {
          "dataset": "trade_calendar",
          "key_fields": ["exchange", "cal_date"],
          "event_time_field": "cal_date",
          "release_timing": "exchange calendar known no later than session open",
          "allows_empty": false,
          "fields": [
            {"name": "exchange", "dtype": "string", "nullable": false},
            {"name": "cal_date", "dtype": "date", "nullable": false},
            {"name": "is_open", "dtype": "int64", "nullable": false},
            {"name": "pretrade_date", "dtype": "date", "nullable": true}
          ]
        },
        "canonicalization": {
          "entity_columns": ["exchange"],
          "event_time_column": "cal_date",
          "value_columns": ["is_open", "pretrade_date"],
          "availability": {
            "mode": "session_release_time",
            "time": "08:00:00",
            "timezone": "Asia/Shanghai",
            "lag_days": 0
          }
        }
      },
      {
        "source": "local_file",
        "profile_name": "pit-reference-local",
        "root": "data/reference/pit",
        "priority": 10,
        "path_templates": {"stock_basic": "stock_basic.parquet"},
        "request": {"dataset": "stock_basic"},
        "contract": {
          "dataset": "stock_basic",
          "key_fields": ["ts_code", "event_date"],
          "event_time_field": "event_date",
          "release_timing": "PIT security-master revision; available_at is required",
          "allows_empty": false,
          "fields": [
            {"name": "ts_code", "dtype": "string", "nullable": false},
            {"name": "event_date", "dtype": "date", "nullable": false},
            {"name": "available_at", "dtype": "timestamp[UTC]", "nullable": false, "release_timing": "vendor publication timestamp"},
            {"name": "list_status", "dtype": "string", "nullable": false},
            {"name": "queried_list_status", "dtype": "string", "nullable": false},
            {"name": "list_date", "dtype": "date", "nullable": false},
            {"name": "delist_date", "dtype": "date", "nullable": true}
          ]
        },
        "canonicalization": {
          "entity_columns": ["ts_code"],
          "event_time_column": "event_date",
          "available_at_column": "available_at",
          "value_columns": ["list_status", "queried_list_status", "list_date", "delist_date"]
        }
      },
      {
        "source": "local_file",
        "profile_name": "pit-reference-local",
        "root": "data/reference/pit",
        "priority": 10,
        "path_templates": {"historical_st": "historical_st.parquet"},
        "request": {"dataset": "historical_st"},
        "contract": {
          "dataset": "historical_st",
          "key_fields": ["ts_code", "event_date"],
          "event_time_field": "event_date",
          "release_timing": "historical ST interval known at available_at",
          "allows_empty": false,
          "fields": [
            {"name": "ts_code", "dtype": "string", "nullable": false},
            {"name": "event_date", "dtype": "date", "nullable": false},
            {"name": "available_at", "dtype": "timestamp[UTC]", "nullable": false, "release_timing": "announcement timestamp"},
            {"name": "start_date", "dtype": "date", "nullable": false},
            {"name": "end_date", "dtype": "date", "nullable": true},
            {"name": "security_name", "dtype": "string", "nullable": true},
            {"name": "change_reason", "dtype": "string", "nullable": true}
          ]
        },
        "canonicalization": {
          "entity_columns": ["ts_code"],
          "event_time_column": "event_date",
          "available_at_column": "available_at",
          "value_columns": ["start_date", "end_date", "security_name", "change_reason"]
        }
      },
      {
        "source": "local_file",
        "profile_name": "pit-reference-local",
        "root": "data/reference/pit",
        "priority": 10,
        "path_templates": {"industry_classification": "industry_classification.parquet"},
        "request": {"dataset": "industry_classification"},
        "contract": {
          "dataset": "industry_classification",
          "key_fields": ["ts_code", "effective_from"],
          "event_time_field": "effective_from",
          "release_timing": "PIT industry revision; available_at is required",
          "allows_empty": false,
          "fields": [
            {"name": "ts_code", "dtype": "string", "nullable": false},
            {"name": "effective_from", "dtype": "date", "nullable": false},
            {"name": "available_at", "dtype": "timestamp[UTC]", "nullable": false, "release_timing": "classification publication timestamp"},
            {"name": "industry", "dtype": "string", "nullable": false}
          ]
        },
        "canonicalization": {
          "entity_columns": ["ts_code"],
          "event_time_column": "effective_from",
          "available_at_column": "available_at",
          "value_columns": ["industry"]
        }
      },
      {
        "source": "local_file",
        "profile_name": "pit-reference-local",
        "root": "data/reference/pit",
        "priority": 10,
        "path_templates": {"company_action": "company_action.parquet"},
        "request": {"dataset": "company_action"},
        "contract": {
          "dataset": "company_action",
          "key_fields": ["ts_code", "trade_date"],
          "event_time_field": "trade_date",
          "release_timing": "action terms usable only at available_at",
          "allows_empty": false,
          "fields": [
            {"name": "ts_code", "dtype": "string", "nullable": false},
            {"name": "trade_date", "dtype": "date", "nullable": false},
            {"name": "available_at", "dtype": "timestamp[UTC]", "nullable": false, "release_timing": "announcement timestamp"},
            {"name": "cash_dividend", "dtype": "float64", "nullable": true, "unit": "CNY per share"},
            {"name": "stock_dividend_ratio", "dtype": "float64", "nullable": true, "unit": "shares per share"}
          ]
        },
        "canonicalization": {
          "entity_columns": ["ts_code"],
          "event_time_column": "trade_date",
          "available_at_column": "available_at",
          "value_columns": ["cash_dividend", "stock_dividend_ratio"]
        }
      }
    ],
    "default_comparison_policy": {
      "absolute_tolerance": 0.000001,
      "relative_tolerance": 0.0001,
      "case_sensitive": true
    },
    "data_quality": {
      "historical_st": {
        "path": "data/reference/pit/historical_st.parquet"
      },
      "minimum_rows": 1,
      "required_gold_columns": ["dataset", "ts_code", "event_time", "available_at"],
      "minimum_core_coverage": 0.95,
      "chinese_text_columns": {}
    },
    "gold": {
      "table_identifier": "factor_lab.gold_research_panel",
      "tag_prefix": "ros_",
      "research_panel": {
        "mode": "research_ready_panel_v1",
        "analysis_start": "2017-01-01",
        "analysis_end": "${partition_key}",
        "snapshot_limit": 50000,
        "required_datasets": [
          "daily",
          "daily_basic",
          "adj_factor",
          "trade_status",
          "trade_calendar",
          "stock_basic",
          "historical_st",
          "industry_classification",
          "company_action"
        ],
        "amount_unit_multiplier": 1000.0,
        "market_cap_unit_multiplier": 10000.0,
        "universe": {
          "mode": "monthly_liquid_top_n",
          "market": "a_share",
          "target_size": 500,
          "liquidity_lookback_sessions": 60,
          "minimum_liquidity_observations": 40,
          "minimum_listing_days": 180,
          "membership_lag_months": 1,
          "st_policy": "exclude_historical",
          "ordinary_a_share_only": true,
          "include_inactive_securities": true,
          "point_in_time": true
        },
        "label": {
          "label_id": "open_t_plus_1_to_t_plus_6",
          "kind": "forward_open_to_open",
          "entry_delay_sessions": 1,
          "horizon_sessions": 5,
          "price_adjustment": "post",
          "diagnostic_only": false
        }
      }
    },
    "shadow": {
      "input_mode": "authoritative_pg",
      "account": {
        "account_id": "champion-shadow",
        "name": "Factor Lab Champion Shadow",
        "initial_capital": 50000000,
        "opened_at": "2026-08-22T15:00:00+08:00",
        "currency": "CNY"
      },
      "market_bars_path": "artifacts/research_os/execution_bars/${partition_key}.parquet",
      "execution": {
        "max_adv_participation": 0.05,
        "max_position_weight": 0.02,
        "lot_size": 100
      }
    }
  },
  "weekly": {
    "input_path": "artifacts/research_os/monitor_inputs/${partition_key}.json"
  },
  "monthly": {
    "input_path": "artifacts/research_os/research_inputs/${partition_key}.json",
    "weights": {
      "input_mode": "authoritative_pg",
      "ridge_alpha": 100.0,
      "minimum_observations": 60,
      "adaptive_fraction": 0.25,
      "sleeve_cap": 0.35,
      "max_monthly_change": 0.05
    },
    "challenger": {
      "historical_challenger_experiment_id": "exp_catalog_authoritative_challenger",
      "shadow_challenger_account_id": "shadow_forward_challenger",
      "shadow_champion_account_id": "shadow_forward_champion",
      "policy": {
        "min_shadow_sessions": 60
      }
    }
  },
  "quarterly": {
    "validation_protocol": {
      "protocol_id": "expanding_nested_walk_forward_v1",
      "initial_train_start": "2017-01-01",
      "initial_train_end": "2020-12-31",
      "outer_test_years": [2021, 2022, 2023, 2024, 2025],
      "diagnostic_years": [2026],
      "purge_sessions": 6,
      "embargo_sessions": 5,
      "annualization_sessions": 252
    }
  },
  "sensors": {
    "trading_partitions_path": "artifacts/research_os/trading_partitions.json"
  }
}
