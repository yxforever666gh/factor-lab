{
  "schema_version": "research-os/runtime-mount-authority/v1",
  "profiles": {
    "windows": {
      "/opt/dagster/home/storage": {
        "type": "volume",
        "name": "factor-lab-research-os_research-os-dagster",
        "read_write": true
      },
      "/opt/factor-lab/runtime/data": {
        "type": "bind",
        "source": "H:/Program Data/factor-lab-runtime/data",
        "read_write": true
      },
      "/opt/factor-lab/runtime/artifacts": {
        "type": "bind",
        "source": "H:/Program Data/factor-lab-runtime/artifacts",
        "read_write": true
      },
      "/run/secrets": {
        "type": "bind",
        "source": "H:/Program Data/factor-lab-runtime/secrets/settings",
        "read_write": false
      },
      "/run/infra-secrets/postgres_password": {
        "type": "bind",
        "source": "H:/Program Data/factor-lab-runtime/secrets/postgres_password",
        "read_write": false
      },
      "/run/infra-secrets/minio_root_user": {
        "type": "bind",
        "source": "H:/Program Data/factor-lab-runtime/secrets/minio_root_user",
        "read_write": false
      },
      "/run/infra-secrets/minio_root_password": {
        "type": "bind",
        "source": "H:/Program Data/factor-lab-runtime/secrets/minio_root_password",
        "read_write": false
      }
    },
    "linux": {
      "/opt/dagster/home/storage": {
