        "read_write": true
      },
      "/run/secrets": {
        "type": "bind",
        "source": "/srv/factor-lab-runtime/secrets/settings",
        "read_write": false
      },
      "/run/infra-secrets/postgres_password": {
        "type": "bind",
        "source": "/srv/factor-lab-runtime/secrets/postgres_password",
        "read_write": false
      },
      "/run/infra-secrets/minio_root_user": {
        "type": "bind",
