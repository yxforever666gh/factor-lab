# Copy this file to .env and fill in local-only secrets.
# Never commit real API keys or tokens.

# Data provider
TUSHARE_TOKEN=replace-me
# WebUI profiles are the runtime bindings used by the checked-in orchestration
# config.  Keep api_key empty here so TUSHARE_TOKEN supplies the local secret.
FACTOR_LAB_DATA_SOURCE_PROFILES_JSON=[{"name":"primary-tushare","source_type":"tushare","api_key":"","enabled":true,"extra":{}},{"name":"secondary-akshare","source_type":"akshare","api_key":"","enabled":true,"extra":{}},{"name":"daily-crosscheck-local","source_type":"local_file","api_key":"","enabled":true,"extra":{}},{"name":"pit-reference-local","source_type":"local_file","api_key":"","enabled":true,"extra":{}}]
FACTOR_LAB_DATA_SOURCE_ORDER=primary-tushare,secondary-akshare,daily-crosscheck-local,pit-reference-local
FACTOR_LAB_PRIMARY_DATA_SOURCE=tushare

# Web UI
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8765

# LLM/provider runtime
FACTOR_LAB_DECISION_PROVIDER=direct_model
FACTOR_LAB_LIVE_DECISION_PROVIDER=direct_model
FACTOR_LAB_OBSERVATION_DECISION_PROVIDER=direct_model
FACTOR_LAB_LLM_BASE_URL=https://example.com/v1
FACTOR_LAB_LLM_MODEL=replace-me
FACTOR_LAB_LLM_API_KEY=replace-me
FACTOR_LAB_LLM_TIMEOUT_SECONDS=60
FACTOR_LAB_LLM_FALLBACK_ORDER=primary

# Research daemon defaults
RESEARCH_DAEMON_IDLE_SECONDS=60
RESEARCH_DAEMON_MAX_TASKS=1
RESEARCH_DAEMON_WAKE_EVENTS=0
FACTOR_LAB_BATCH_MAX_WORKERS=1

# Research OS authoritative infrastructure (local Docker Compose defaults)
RESEARCH_OS_DATABASE_URL=postgresql+psycopg://factor_lab@127.0.0.1:15432/factor_lab
FACTOR_LAB_DATABASE_URL=postgresql+psycopg://factor_lab@127.0.0.1:15432/factor_lab
FACTOR_LAB_POSTGRES_PASSWORD_FILE=H:/Program Data/factor-lab-runtime/secrets/postgres_password
FACTOR_LAB_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
FACTOR_LAB_OBJECT_STORE_BUCKET=factor-lab
FACTOR_LAB_OBJECT_STORE_ACCESS_KEY_FILE=H:/Program Data/factor-lab-runtime/secrets/minio_root_user
FACTOR_LAB_OBJECT_STORE_SECRET_KEY_FILE=H:/Program Data/factor-lab-runtime/secrets/minio_root_password
FACTOR_LAB_ICEBERG_CATALOG_URI=postgresql+psycopg2://factor_lab@127.0.0.1:15432/factor_lab
FACTOR_LAB_ICEBERG_WAREHOUSE=s3://factor-lab/warehouse
FACTOR_LAB_ORCHESTRATION_FACTORY=factor_lab.research_os.application_services:create_services
FACTOR_LAB_ORCHESTRATION_CONFIG=configs/research_os_orchestration.example.json
