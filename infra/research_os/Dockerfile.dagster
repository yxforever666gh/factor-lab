FROM python:3.11-slim-bookworm@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91

LABEL org.opencontainers.image.base.name="docker.io/library/python:3.11-slim-bookworm" \
      org.opencontainers.image.base.digest="sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DAGSTER_HOME=/opt/dagster/home \
    FACTOR_LAB_SOURCE_BUNDLE_MANIFEST=/opt/factor-lab/.factor-lab-source-bundle.json \
    UV_LINK_MODE=copy \
    PATH=/opt/factor-lab/.venv/bin:$PATH

WORKDIR /opt/factor-lab
COPY pyproject.toml /opt/factor-lab/pyproject.toml
COPY uv.lock /opt/factor-lab/uv.lock
RUN --mount=type=cache,target=/root/.cache/uv \
    pip install --no-cache-dir "uv==0.12.5" \
    && uv sync --frozen --extra research-os --no-dev --no-install-project

COPY src /opt/factor-lab/src
COPY configs /opt/factor-lab/configs
COPY infra/research_os /opt/factor-lab/infra/research_os
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra research-os --no-dev
RUN python /opt/factor-lab/src/factor_lab/research_os/build_provenance.py \
      --bundle-root /opt/factor-lab \
      --source-root src \
      --configuration-root configs \
      --dependency-lock uv.lock \
      --runtime-root infra/research_os \
      --output /opt/factor-lab/.factor-lab-source-bundle.json

COPY infra/research_os/dagster.yaml /opt/dagster/home/dagster.yaml
COPY infra/research_os/workspace.yaml /opt/dagster/workspace.yaml
COPY infra/research_os/alembic.ini /opt/factor-lab/infra/research_os/alembic.ini
COPY infra/research_os/container-entrypoint.sh /usr/local/bin/factor-lab-entrypoint

RUN useradd --create-home --uid 10001 dagster \
    && mkdir -p /opt/dagster/home/storage \
    && chown -R dagster:dagster /opt/dagster \
    && chmod 0555 /usr/local/bin/factor-lab-entrypoint \
    && chmod -R a-w /opt/factor-lab/src /opt/factor-lab/configs \
    && chmod a-w /opt/factor-lab/uv.lock /opt/factor-lab/.factor-lab-source-bundle.json

USER dagster

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/factor-lab-entrypoint"]
