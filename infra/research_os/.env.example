RESEARCH_OS_POSTGRES_PORT=15432
RESEARCH_OS_MINIO_API_PORT=9000
RESEARCH_OS_MINIO_CONSOLE_PORT=9001
RESEARCH_OS_DAGSTER_PORT=8766
RESEARCH_OS_WEBUI_PORT=8765
RESEARCH_OS_IMAGE_TAG=local
RESEARCH_OS_OCI_IMAGE_ID=
RESEARCH_OS_POSTGRES_DB=factor_lab
# Runtime roots are explicit H-drive bind mounts. Data is read-only in the
# containers; generated artifacts use a separate writable root.
RESEARCH_OS_DATA_ROOT=H:/Program Data/factor-lab-runtime/data
RESEARCH_OS_ARTIFACT_ROOT=H:/Program Data/factor-lab-runtime/artifacts
# Only source and LLM editor secrets live here. PostgreSQL/MinIO credentials
# must remain in the parent infrastructure-secret directory and are never
# mounted into the WebUI.
RESEARCH_OS_SETTINGS_SECRETS_ROOT=H:/Program Data/factor-lab-runtime/secrets/settings
RESEARCH_OS_WEBUI_SETTINGS_ROOT=H:/Program Data/factor-lab-runtime/artifacts/settings
# Secret values never belong in this env file. Each variable points at a
# one-line UTF-8 file outside the repository.
RESEARCH_OS_POSTGRES_USER=
RESEARCH_OS_POSTGRES_PASSWORD_FILE=H:/Program Data/factor-lab-runtime/secrets/postgres_password
RESEARCH_OS_WEBUI_POSTGRES_USER=factor_lab_webui
RESEARCH_OS_WEBUI_POSTGRES_PASSWORD_FILE=H:/Program Data/factor-lab-runtime/secrets/webui_postgres_password
RESEARCH_OS_MINIO_ROOT_USER_FILE=H:/Program Data/factor-lab-runtime/secrets/minio_root_user
RESEARCH_OS_MINIO_ROOT_PASSWORD_FILE=H:/Program Data/factor-lab-runtime/secrets/minio_root_password
RESEARCH_OS_TUSHARE_TOKEN_FILE=H:/Program Data/factor-lab-runtime/secrets/settings/tushare_token
RESEARCH_OS_DIEMENG_API_KEY_FILE=H:/Program Data/factor-lab-runtime/secrets/settings/diemeng_api_key
RESEARCH_OS_MINIO_BUCKET=factor-lab
# Required before enabling schedules. The factory returns an object implementing
# factor_lab.research_os.orchestration.ResearchOSServices.
FACTOR_LAB_ORCHESTRATION_FACTORY=factor_lab.research_os.application_services:create_services
