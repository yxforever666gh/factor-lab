    "signal_schedule": "last official SSE session of each natural calendar quarter after close",
    "execution": "immediate next official SSE session open",
    "session_index_semantics": "t is the official-session index of the quarter-end signal; t-252 and t-21 are exact earlier official-session indices",
    "momentum_formula": "m_i(t) = log(TRI_i[t-21] / TRI_i[t-252]) - log(TRI_511880.SH[t-21] / TRI_511880.SH[t-252])",
    "required_endpoint_rule": "all six assets must have observed TRI rows at both t-252 and t-21; a missing or unobserved required endpoint makes the entire target 100% 511880.SH, while non-finite or non-positive TRI is malformed source data rejected before target construction",
    "positive_set": "P(t) = {i in risk_codes_in_frozen_tie_order: m_i(t) > 0}",
    "ranking": "sort P by m_i descending; an exact tie uses risk_codes_in_frozen_tie_order",
    "borda_score": "for n = |P| and one-based rank r_i, q_i = n - r_i + 1",
    "target_weight": "w_i = q_i / (n*(n+1)/2) for i in P; all other risk weights are zero; w_cash = 1 - math.fsum(risk weights); if P is empty w_cash = 1",
    "risk_codes_in_frozen_tie_order": [
      "510300.SH",
      "159920.SZ",
      "513100.SH",
      "518880.SH",
      "511010.SH"
    ],
