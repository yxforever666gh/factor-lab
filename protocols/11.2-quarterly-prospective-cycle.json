    "target_builder": "factor_lab.research.multi_asset.build_monthly_targets",
    "execution_simulator": "factor_lab.research.multi_asset.simulate_targets",
    "signal_schedule": "last official SSE session of each natural calendar quarter after close",
    "execution": "immediate next official SSE session open",
    "session_index_semantics": "t is the official-session index of the quarter-end signal; t-252, t-126 and t-21 are exact earlier official-session indices",
    "long_momentum_formula": "m12_i(t) = log(TRI_i[t-21] / TRI_i[t-252]) - log(TRI_511880.SH[t-21] / TRI_511880.SH[t-252])",
    "short_momentum_formula": "m6_i(t) = log(TRI_i[t-21] / TRI_i[t-126]) - log(TRI_511880.SH[t-21] / TRI_511880.SH[t-126])",
    "long_positive_set": "P12(t) = {i in risk_codes_in_frozen_tie_order: m12_i(t) > 0}",
    "dual_positive_set": "D(t) = {i in P12(t): m6_i(t) > 0}",
    "ranking": "sort P12 and D by m12 descending; an exact tie uses risk_codes_in_frozen_tie_order",
    "dual_component": "select the first min(3, |D|) assets; give each selected asset 1/k when k>0 and otherwise allocate 100% to 511880.SH",
    "borda_component": "for n=|P12| and one-based m12 rank r_i, b_i=(n-r_i+1)/(n*(n+1)/2); nonmembers have zero; if P12 is empty allocate 100% to 511880.SH",
    "blend_formula": "for each risk asset i, w_i=0.75*d_i+0.25*b_i; w_511880.SH=1-math.fsum(risk weights)",
    "required_endpoint_rule": {
      "long_window": "all six assets require observed TRI rows at t-252 and t-21; any missing endpoint makes both components and the final target 100% 511880.SH",
      "short_window": "all six assets require observed TRI rows at t-126 and t-21; any missing endpoint makes both components and the final target 100% 511880.SH",
      "malformed_source": "non-finite or non-positive TRI is malformed source data and is rejected before target construction"
    },
    "dual_top_k": 3,
    "dual_weight": 0.75,
    "published_10_0_borda_weight": 0.25,
    "volatility_weighting": false,
    "leverage": false,
